# Supabase Postgres — same value as apps/frontend/.env DATABASE_URL.
# analytics-service reads from the same database Looqus writes to.
DATABASE_URL=

# Redis — provided by the SP-1 docker stack.
REDIS_URL=redis://127.0.0.1:6379/0

# Ports
HTTP_PORT=8000
GRPC_PORT=50051
HOST=127.0.0.1

# asyncpg pool sizing
PG_POOL_SIZE=10
