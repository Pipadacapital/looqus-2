generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum SystemRole {
  SUPERADMIN
  USER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SubscriptionPlan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  REVOKED
}

enum NotificationType {
  WORKSPACE_INVITE
  INVITE_ACCEPTED
  MEMBER_JOINED
  MEMBER_REMOVED
  ROLE_CHANGED
  SHOPIFY_CONNECTED
  SHOPIFY_DISCONNECTED
  META_ADS_CONNECTED
  META_ADS_DISCONNECTED
  GOOGLE_ADS_CONNECTED
  GOOGLE_ADS_DISCONNECTED
  SYNC_COMPLETED
  SYNC_FAILED
  SYSTEM
}

enum OAuthProvider {
  META
  GOOGLE
}



model User {
  id         String     @id @db.Uuid
  email      String     @unique
  fullName   String?    @map("full_name")
  avatarUrl  String?    @map("avatar_url")
  jobRole    String?    @map("job_role")
  systemRole SystemRole @default(USER) @map("system_role")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships     WorkspaceMember[]
  invitationsSent Invitation[]      @relation("InvitedBy")
  ownedWorkspaces Workspace[]       @relation("WorkspaceCreator")
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@map("users")
}

// ─── Workspace ──────────────────────────────────────────────────────────────
// Each workspace represents a single brand/business tenant.

model Workspace {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String
  slug    String  @unique
  logoUrl String? @map("logo_url")

  industry       String? @map("industry")
  monthlyRevenue String? @map("monthly_revenue")
  storeUrl       String? @map("store_url")

  plan SubscriptionPlan @default(FREE)

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation("WorkspaceCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members              WorkspaceMember[]
  invitations          Invitation[]
  shopifyConnections   ShopifyConnection[]
  metaAdsConnections   MetaAdsConnection[]
  googleAdsConnections GoogleAdsConnection[]
  auditLogs            AuditLog[]
  notifications        Notification[]

  @@map("workspaces")
}

// ─── Workspace Member ───────────────────────────────────────────────────────
// Junction table: assigns a role to a user within a workspace.

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  role        WorkspaceRole @default(VIEWER)

  joinedAt  DateTime @default(now()) @map("joined_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("workspace_members")
}

// ─── Invitation ─────────────────────────────────────────────────────────────
// Invite users to a workspace. Tracks status and expiration.

model Invitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String
  workspaceId String           @map("workspace_id") @db.Uuid
  role        WorkspaceRole    @default(VIEWER)
  status      InvitationStatus @default(PENDING)
  token       String           @unique @default(dbgenerated("gen_random_uuid()"))

  invitedById String    @map("invited_by_id") @db.Uuid
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email, workspaceId])
  @@index([token])
  @@map("invitations")
}

// ─── Shopify Connection ─────────────────────────────────────────────────────
// Each workspace can connect one or more Shopify stores.

model ShopifyConnection {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  shopDomain     String           @map("shop_domain")
  shopifyStoreId String?          @map("shopify_store_id")
  clientId       String           @map("client_id")
  clientSecret   String           @map("client_secret")
  accessToken    String?          @map("access_token")
  tokenExpiresAt DateTime?        @map("token_expires_at")
  scopes         String[]
  status         ConnectionStatus @default(CONNECTED)

  installedAt DateTime  @default(now()) @map("installed_at")
  lastSyncAt  DateTime? @map("last_sync_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, shopDomain])
  @@map("shopify_connections")
}

// ─── OAuth State ────────────────────────────────────────────────────────────
// Server-side CSRF protection for OAuth flows. TTL ~10 minutes.

model OAuthState {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     OAuthProvider
  workspaceId  String        @map("workspace_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  stateHash    String        @unique @map("state_hash")
  codeVerifier String?       @map("code_verifier")
  expiresAt    DateTime      @map("expires_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([stateHash])
  @@index([expiresAt])
  @@map("oauth_states")
}

// ─── Meta Ads Connection ────────────────────────────────────────────────────

model MetaAdsConnection {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String           @map("workspace_id") @db.Uuid
  accessToken         String           @map("access_token")
  tokenExpiresAt      DateTime?        @map("token_expires_at")
  scopes              String[]
  adAccountIds        String[]         @map("ad_account_ids")
  selectedAdAccountId String?          @map("selected_ad_account_id")
  businessId          String?          @map("business_id")
  metaUserId          String?          @map("meta_user_id")
  status              ConnectionStatus @default(CONNECTED)

  lastSyncAt    DateTime?        @map("last_sync_at")
  lastSyncError String?          @map("last_sync_error")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dailyMetrics  MetaAdsDailyMetric[]

  @@unique([workspaceId])
  @@map("meta_ads_connections")
}

// ─── Google Ads Connection ──────────────────────────────────────────────────

model GoogleAdsConnection {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String           @map("workspace_id") @db.Uuid
  refreshToken       String           @map("refresh_token")
  scopes             String[]
  customerIds        String[]         @map("customer_ids")
  selectedCustomerId String?          @map("selected_customer_id")
  loginCustomerId    String?          @map("login_customer_id")
  googleEmail        String?          @map("google_email")
  status             ConnectionStatus @default(CONNECTED)

  lastSyncAt       DateTime?        @map("last_sync_at")
  lastSyncError    String?          @map("last_sync_error")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dailyMetrics     GoogleAdsDailyMetric[]

  @@unique([workspaceId])
  @@map("google_ads_connections")
}

// ─── Meta Ads Daily Metric ──────────────────────────────────────────────────

model MetaAdsDailyMetric {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  adAccountId    String   @map("ad_account_id")
  campaignId     String   @map("campaign_id")
  campaignName   String   @map("campaign_name")
  adsetId        String?  @map("adset_id")
  adsetName      String?  @map("adset_name")
  date           DateTime @db.Date
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  spend          Decimal  @default(0) @db.Decimal(12, 4)
  conversions    Int      @default(0)
  revenue        Decimal  @default(0) @db.Decimal(12, 4)
  ctr            Decimal  @default(0) @db.Decimal(8, 4)
  cpc            Decimal  @default(0) @db.Decimal(8, 4)
  cpm            Decimal  @default(0) @db.Decimal(8, 4)
  rawJson        Json?    @map("raw_json")

  createdAt      DateTime @default(now()) @map("created_at")

  connection     MetaAdsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, adAccountId, campaignId, date])
  @@index([connectionId, date])
  @@map("meta_ads_daily_metrics")
}

// ─── Google Ads Daily Metric ────────────────────────────────────────────────

model GoogleAdsDailyMetric {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  customerId     String   @map("customer_id")
  campaignId     String   @map("campaign_id")
  campaignName   String   @map("campaign_name")
  adGroupId      String?  @map("ad_group_id")
  adGroupName    String?  @map("ad_group_name")
  date           DateTime @db.Date
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  spend          Decimal  @default(0) @db.Decimal(12, 4)
  conversions    Decimal  @default(0) @db.Decimal(12, 4)
  conversionValue Decimal @default(0) @map("conversion_value") @db.Decimal(12, 4)
  ctr            Decimal  @default(0) @db.Decimal(8, 4)
  averageCpc     Decimal  @default(0) @map("average_cpc") @db.Decimal(8, 4)
  rawJson        Json?    @map("raw_json")

  createdAt      DateTime @default(now()) @map("created_at")

  connection     GoogleAdsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, customerId, campaignId, date])
  @@index([connectionId, date])
  @@map("google_ads_daily_metrics")
}

// ─── Audit Log ──────────────────────────────────────────────────────────────
// Immutable log of significant actions for compliance and debugging.

model AuditLog {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String? @map("workspace_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid

  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")
  metadata   Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── Notification ────────────────────────────────────────────────────────────
// In-app notifications for users across all event types.

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  workspaceId String?          @map("workspace_id") @db.Uuid
  type        NotificationType
  title       String
  body        String?
  actionUrl   String?          @map("action_url")
  read        Boolean          @default(false)
  metadata    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
  @@index([workspaceId, createdAt])
  @@map("notifications")
}
