/// Per campaign-day funnel stages (from GAQL segmented by conversion_action).
model google_ads_funnel_daily {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connection_id     String                 @db.Uuid
  customer_id       String
  campaign_id       String
