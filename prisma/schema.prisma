  conversion_value  Decimal                @default(0) @db.Decimal(14, 4)
  created_at        DateTime               @default(now())
  google_ads_connections google_ads_connections @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@unique([connection_id, customer_id, campaign_id, date, stage])
  @@index([connection_id, customer_id, date])
  @@map("google_ads_funnel_daily")
}

