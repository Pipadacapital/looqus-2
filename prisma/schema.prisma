generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String            @id @db.Uuid
  email           String            @unique
  fullName        String?           @map("full_name")
  avatarUrl       String?           @map("avatar_url")
  jobRole         String?           @map("job_role")
  systemRole      SystemRole        @default(USER) @map("system_role")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  auditLogs       AuditLog[]
  invitationsSent Invitation[]      @relation("InvitedBy")
  notifications   Notification[]
  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceCreator")

  @@map("users")
}

model Workspace {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  slug                   String                  @unique
  logoUrl                String?                 @map("logo_url")
  industry               String?                 @map("industry")
  monthlyRevenue         String?                 @map("monthly_revenue")
  storeUrl               String?                 @map("store_url")
  plan                   SubscriptionPlan        @default(FREE)
  createdById            String                  @map("created_by_id") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  auditLogs              AuditLog[]
  google_ads_connections google_ads_connections?
  invitations            Invitation[]
  meta_ads_connections   meta_ads_connections?
  notifications          Notification[]
  shiprocketConnection   ShiprocketConnection?
  shopifyConnections     ShopifyConnection[]
  members                WorkspaceMember[]
  costs                  WorkspaceCost[]
  miscExpenses           WorkspaceMiscExpense[]
  createdBy              User                    @relation("WorkspaceCreator", fields: [createdById], references: [id])

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  role        WorkspaceRole @default(VIEWER)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Invitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String
  workspaceId String           @map("workspace_id") @db.Uuid
  role        WorkspaceRole    @default(VIEWER)
  status      InvitationStatus @default(PENDING)
  token       String           @unique @default(dbgenerated("gen_random_uuid()"))
  invitedById String           @map("invited_by_id") @db.Uuid
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email, workspaceId])
  @@index([token])
  @@map("invitations")
}

model WorkspaceCost {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String            @map("workspace_id") @db.Uuid
  costType      WorkspaceCostType @map("cost_type")
  name          String?           @db.VarChar(120)
  amount        Decimal           @db.Decimal(12, 2)
  isPercent     Boolean           @default(false) @map("is_percent")
  effectiveFrom DateTime          @map("effective_from") @db.Date
  effectiveTo   DateTime?         @map("effective_to") @db.Date
  currency      String?           @default("USD") @db.VarChar(3)
  createdAt     DateTime          @default(now()) @map("created_at")
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, costType, effectiveFrom, effectiveTo])
  @@map("workspace_costs")
}

model WorkspaceMiscExpense {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  name               String    @db.VarChar(200)
  amount             Decimal   @db.Decimal(12, 2)
  currency           String    @default("INR") @db.VarChar(3)
  effectiveStartDate DateTime  @map("effective_start_date") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, effectiveStartDate])
  @@map("workspace_misc_expenses")
}

model ShopifyConnection {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String                  @map("workspace_id") @db.Uuid
  shopDomain     String                  @map("shop_domain")
  shopifyStoreId String?                 @map("shopify_store_id")
  accessToken    String?                 @map("access_token")
  scopes         String[]
  status         ConnectionStatus        @default(CONNECTED)
  installedAt    DateTime                @default(now()) @map("installed_at")
  lastSyncAt     DateTime?               @map("last_sync_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  clientId       String                  @map("client_id")
  clientSecret   String                  @map("client_secret")
  tokenExpiresAt DateTime?               @map("token_expires_at")
  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  analyticsDaily ShopifyAnalyticsDaily[]
  customers      ShopifyCustomer[]
  lineItems      ShopifyLineItem[]
  orders         ShopifyOrder[]
  products       ShopifyProduct[]

  @@unique([workspaceId, shopDomain])
  @@map("shopify_connections")
}

model ShopifyAnalyticsDaily {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId    String            @map("connection_id") @db.Uuid
  date            DateTime          @db.Date
  netSales        Decimal           @map("net_sales") @db.Decimal(12, 2)
  grossSales      Decimal           @map("gross_sales") @db.Decimal(12, 2)
  ordersCount     Int               @map("orders_count")
  aov             Decimal           @db.Decimal(12, 2)
  totalTax        Decimal           @map("total_tax") @db.Decimal(12, 2)
  totalDiscount   Decimal           @map("total_discount") @db.Decimal(12, 2)
  currency        String
  sessions        Int?              @db.Integer
  conversionRate  Decimal?          @map("conversion_rate") @db.Decimal(8, 4)
  updatedAt       DateTime          @updatedAt @map("updated_at")
  connection      ShopifyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, date])
  @@index([connectionId, date])
  @@map("shopify_analytics_daily")
}

model ShopifyOrder {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId      String            @map("connection_id") @db.Uuid
  shopifyId         String            @map("shopify_id")
  orderNumber       String            @map("order_number")
  name              String
  email             String?
  totalPrice        Decimal           @map("total_price") @db.Decimal(12, 2)
  subtotalPrice     Decimal           @map("subtotal_price") @db.Decimal(12, 2)
  totalTax          Decimal           @map("total_tax") @db.Decimal(12, 2)
  totalDiscount     Decimal           @map("total_discount") @db.Decimal(12, 2)
  currency          String
  financialStatus   String            @map("financial_status")
  fulfillmentStatus String?           @map("fulfillment_status")
  customerShopifyId String?           @map("customer_shopify_id")
  processedAt       DateTime          @map("processed_at")
  cancelledAt       DateTime?         @map("cancelled_at")
  tags              String[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  lineItems         ShopifyLineItem[]
  connection        ShopifyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, shopifyId])
  @@index([connectionId, processedAt])
  @@map("shopify_orders")
}

model ShopifyLineItem {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String            @map("order_id") @db.Uuid
  connectionId     String            @map("connection_id") @db.Uuid
  shopifyId        String            @map("shopify_id")
  title            String
  quantity         Int
  price            Decimal           @db.Decimal(12, 2)
  sku              String?
  variantTitle     String?           @map("variant_title")
  productShopifyId String?           @map("product_shopify_id")
  connection       ShopifyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  order            ShopifyOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([connectionId, shopifyId])
  @@index([orderId])
  @@map("shopify_line_items")
}

model ShopifyProduct {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId   String            @map("connection_id") @db.Uuid
  shopifyId      String            @map("shopify_id")
  title          String
  handle         String
  vendor         String?
  productType    String?           @map("product_type")
  status         String
  tags           String[]
  imageUrl       String?           @map("image_url")
  totalInventory Int?              @map("total_inventory")
  publishedAt    DateTime?         @map("published_at")
  coq            Decimal?          @map("coq") @db.Decimal(12, 4)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  connection     ShopifyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, shopifyId])
  @@index([connectionId])
  @@map("shopify_products")
}

model ShopifyCustomer {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId     String            @map("connection_id") @db.Uuid
  shopifyId        String            @map("shopify_id")
  email            String?
  firstName        String?           @map("first_name")
  lastName         String?           @map("last_name")
  ordersCount      Int               @default(0) @map("orders_count")
  totalSpent       Decimal           @default(0) @map("total_spent") @db.Decimal(12, 2)
  currency         String?
  tags             String[]
  state            String?
  shopifyCreatedAt DateTime?         @map("shopify_created_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  connection       ShopifyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, shopifyId])
  @@index([connectionId])
  @@map("shopify_customers")
}

model ShiprocketConnection {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String               @unique @map("workspace_id") @db.Uuid
  email              String
  password           String
  accessToken        String?              @map("access_token")
  tokenObtainedAt    DateTime?            @map("token_obtained_at")
  status             ConnectionStatus     @default(CONNECTED)
  channels           Json?
  selectedChannelIds String[]             @map("selected_channel_ids")
  lastSyncAt         DateTime?            @map("last_sync_at")
  lastSyncError      String?              @map("last_sync_error")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders             ShiprocketOrder[]
  shipments          ShiprocketShipment[]

  @@map("shiprocket_connections")
}

model ShiprocketOrder {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId   String               @map("connection_id") @db.Uuid
  shiprocketId   String               @map("shiprocket_id")
  channelId      String?              @map("channel_id")
  channelOrderId String?              @map("channel_order_id")
  status         String?
  statusCode     Int?                 @map("status_code")
  paymentMethod  String?              @map("payment_method")
  total          Decimal?             @db.Decimal(12, 2)
  orderDate      DateTime?            @map("order_date")
  channelName    String?              @map("channel_name")
  rawJson        Json?                @map("raw_json")
  syncedAt       DateTime             @default(now()) @map("synced_at")
  connection     ShiprocketConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, shiprocketId])
  @@index([connectionId, orderDate])
  @@map("shiprocket_orders")
}

model ShiprocketShipment {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId         String               @map("connection_id") @db.Uuid
  shipmentId           String               @map("shipment_id")
  orderId              String?              @map("order_id")
  channelOrderId       String?              @map("channel_order_id")
  status               String?
  statusCode           Int?                 @map("status_code")
  courierName          String?              @map("courier_name")
  awbCode              String?              @map("awb_code")
  isCod                Boolean              @default(false) @map("is_cod")
  codAmount            Decimal?             @map("cod_amount") @db.Decimal(12, 2)
  paymentMethod        String?              @map("payment_method")
  shippedAt            DateTime?            @map("shipped_at")
  deliveredAt          DateTime?            @map("delivered_at")
  rtoInitiatedAt       DateTime?            @map("rto_initiated_at")
  charges              Decimal?             @db.Decimal(12, 2)
  trackingStatusCode   Int?                 @map("tracking_status_code")
  trackingStatus       String?              @map("tracking_status")
  trackingUpdatedAt    DateTime?            @map("tracking_updated_at")
  shiprocketCreatedAt  DateTime?            @map("shiprocket_created_at")
  shopifyOrderName     String?              @map("shopify_order_name")
  rawJson              Json?                @map("raw_json")
  syncedAt             DateTime             @default(now()) @map("synced_at")
  connection           ShiprocketConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, shipmentId])
  @@index([connectionId, trackingStatusCode])
  @@index([connectionId, shiprocketCreatedAt])
  @@map("shiprocket_shipments")
}

model AuditLog {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?    @map("workspace_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  action      String
  entityType  String     @map("entity_type")
  entityId    String?    @map("entity_id")
  metadata    Json?
  ipAddress   String?    @map("ip_address")
  userAgent   String?    @map("user_agent")
  createdAt   DateTime   @default(now()) @map("created_at")
  user        User       @relation(fields: [userId], references: [id])
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  workspaceId String?          @map("workspace_id") @db.Uuid
  type        NotificationType
  title       String
  body        String?
  actionUrl   String?          @map("action_url")
  read        Boolean          @default(false)
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  readAt      DateTime?        @map("read_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id])

  @@index([userId, read, createdAt])
  @@index([workspaceId, createdAt])
  @@map("notifications")
}

model google_ads_connections {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id             String                     @unique @db.Uuid
  refresh_token            String
  scopes                   String[]
  customer_ids             String[]
  login_customer_id        String?
  google_email             String?
  status                   ConnectionStatus           @default(CONNECTED)
  last_sync_at             DateTime?
  last_sync_error          String?
  created_at               DateTime                   @default(now())
  updated_at               DateTime
  selected_customer_id     String?
  selected_customer_ids    String[]
  workspaces               Workspace                  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  google_ads_daily_metrics google_ads_daily_metrics[]
}

model google_ads_daily_metrics {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connection_id          String                 @db.Uuid
  customer_id            String
  campaign_id            String
  campaign_name          String
  ad_group_id            String?
  ad_group_name          String?
  date                   DateTime               @db.Date
  impressions            Int                    @default(0)
  clicks                 Int                    @default(0)
  spend                  Decimal                @default(0) @db.Decimal(12, 4)
  conversions            Decimal                @default(0) @db.Decimal(12, 4)
  conversion_value       Decimal                @default(0) @db.Decimal(12, 4)
  ctr                    Decimal                @default(0) @db.Decimal(8, 4)
  average_cpc            Decimal                @default(0) @db.Decimal(8, 4)
  raw_json               Json?
  created_at             DateTime               @default(now())
  google_ads_connections google_ads_connections @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@unique([connection_id, customer_id, campaign_id, date])
  @@index([connection_id, date])
}

model meta_ads_connections {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id           String                   @unique @db.Uuid
  access_token           String
  token_expires_at       DateTime?
  scopes                 String[]
  ad_account_ids         String[]
  business_id            String?
  meta_user_id           String?
  status                 ConnectionStatus         @default(CONNECTED)
  last_sync_at           DateTime?
  last_sync_error        String?
  created_at             DateTime                 @default(now())
  updated_at             DateTime
  selected_ad_account_id  String?
  selected_ad_account_ids String[]
  workspaces              Workspace                @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  meta_ads_daily_metrics  meta_ads_daily_metrics[]
}

model meta_ads_daily_metrics {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connection_id        String               @db.Uuid
  ad_account_id        String
  campaign_id          String
  campaign_name        String
  adset_id             String?
  adset_name           String?
  date                 DateTime             @db.Date
  impressions          Int                  @default(0)
  clicks               Int                  @default(0)
  spend                Decimal              @default(0) @db.Decimal(12, 4)
  conversions          Int                  @default(0)
  revenue              Decimal              @default(0) @db.Decimal(12, 4)
  ctr                  Decimal              @default(0) @db.Decimal(8, 4)
  cpc                  Decimal              @default(0) @db.Decimal(8, 4)
  cpm                  Decimal              @default(0) @db.Decimal(8, 4)
  raw_json             Json?
  created_at           DateTime             @default(now())
  meta_ads_connections meta_ads_connections @relation(fields: [connection_id], references: [id], onDelete: Cascade)

  @@unique([connection_id, ad_account_id, campaign_id, date])
  @@index([connection_id, date])
}

model oauth_states {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider      OAuthProvider
  workspace_id  String        @db.Uuid
  user_id       String        @db.Uuid
  state_hash    String        @unique
  code_verifier String?
  expires_at    DateTime
  created_at    DateTime      @default(now())

  @@index([expires_at])
  @@index([state_hash])
}

enum SystemRole {
  SUPERADMIN
  USER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  ANALYST
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SubscriptionPlan {
  // s
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  REVOKED
}

enum NotificationType {
  WORKSPACE_INVITE
  INVITE_ACCEPTED
  MEMBER_JOINED
  MEMBER_REMOVED
  ROLE_CHANGED
  SHOPIFY_CONNECTED
  SHOPIFY_DISCONNECTED
  SYNC_COMPLETED
  SYNC_FAILED
  SYSTEM
  META_ADS_CONNECTED
  META_ADS_DISCONNECTED
  GOOGLE_ADS_CONNECTED
  GOOGLE_ADS_DISCONNECTED
}

enum OAuthProvider {
  META
  GOOGLE
}

enum WorkspaceCostType {
  SHIPPING
  PACKAGING
 
  WEBSITE
  CUSTOM
}
