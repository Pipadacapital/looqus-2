generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String            @id @db.Uuid
  email           String            @unique
  fullName        String?           @map("full_name")
  avatarUrl       String?           @map("avatar_url")
  jobRole         String?           @map("job_role")
  systemRole      SystemRole        @default(USER) @map("system_role")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  auditLogs       AuditLog[]
  invitationsSent Invitation[]      @relation("InvitedBy")
  notifications   Notification[]
  memberships            WorkspaceMember[]
  ownedWorkspaces        Workspace[]         @relation("WorkspaceCreator")
  marketingActionsCreated MarketingAction[] @relation("MarketingActionCreator")

  @@map("users")
}

model MarketingAction {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  actionDate    DateTime  @map("action_date") @db.Date
  actionType    String    @map("action_type") @db.VarChar(48)
  actionName    String    @map("action_name") @db.VarChar(256)
  notes         String?   @db.Text
  createdById   String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User?     @relation("MarketingActionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, actionDate])
  @@map("marketing_actions")
}

model Workspace {
  id                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String
  slug                       String                     @unique
  logoUrl                    String?                    @map("logo_url")
  industry                   String?                    @map("industry")
  monthlyRevenue             String?                    @map("monthly_revenue")
  storeUrl                   String?                    @map("store_url")
  plan                       SubscriptionPlan           @default(FREE)
  createdById                String                     @map("created_by_id") @db.Uuid
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")
  founder_salary_currency    String?                    @db.VarChar(3)
  founder_salary_monthly     Decimal?                   @db.Decimal(12, 2)
  taxPercent                 Decimal                    @default(0) @map("tax_percent") @db.Decimal(5, 2)
  timezone                   String                     @default("UTC") @db.VarChar(100)
  skip_zero_sales_orders     Boolean                    @default(false)
  skipped_shopify_order_tags String[]                   @default([])
  auditLogs                  AuditLog[]
  google_ads_connections     google_ads_connections?
  invitations                Invitation[]
  meta_ads_connections       meta_ads_connections?
  notifications              Notification[]
  shiprocketConnection       ShiprocketConnection?
  klaviyoConnection          KlaviyoConnection?
  shopifyConnections         ShopifyConnection[]
  emailPerformanceRows       EmailPerformance[]
  aiInsightsCache            WorkspaceAiInsightsCache[]
  cogsSettings               WorkspaceCogsSettings?
  costs                      WorkspaceCost[]
  workspaceDailyMetrics      WorkspaceDailyMetrics[]
  members                    WorkspaceMember[]
  miscExpenses               WorkspaceMiscExpense[]
  adCampaignClassifications  WorkspaceAdCampaignClassification[]
  festivals                  WorkspaceFestival[]
  metricGoals                WorkspaceMetricGoal[]
  marketingActions           MarketingAction[]
  createdBy                  User                       @relation("WorkspaceCreator", fields: [createdById], references: [id])

  @@map("workspaces")
}

model WorkspaceFestival {
  id                 String    @id @default(uuid())
  workspaceId        String    @map("workspace_id") @db.Uuid
  name               String
  startDate          DateTime  @map("start_date")
  endDate            DateTime  @map("end_date")
  color              String    @default("#F59E0B")
  expectedMultiplier Float     @default(1.5) @map("expected_multiplier")
  regions            String[]  @default([])
  categories         String[]  @default([])
  isTemplate         Boolean   @default(false) @map("is_template")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name, startDate])
  @@index([workspaceId, startDate])
  @@map("workspace_festivals")
}

enum WorkspaceGoalPeriodType {
  DAILY
  WEEKLY
  MONTHLY
}

enum WorkspaceGoalValueType {
  MINIMUM
  MAXIMUM
  TARGET
}

model WorkspaceMetricGoal {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String                  @map("workspace_id") @db.Uuid
  metricName  String                  @map("metric_name") @db.VarChar(64)
  periodType  WorkspaceGoalPeriodType @map("period_type")
  periodStart DateTime                @map("period_start") @db.Date
  goalValue   Decimal                 @map("goal_value") @db.Decimal(18, 6)
  goalType    WorkspaceGoalValueType  @map("goal_type")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metricName, periodType, periodStart])
  @@index([workspaceId])
  @@map("workspace_metric_goals")
}

model WorkspaceAdCampaignClassification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  platform     String    @db.VarChar(32)
  campaignId   String    @map("campaign_id") @db.VarChar(128)
  intent       String    @db.VarChar(32)
  campaignName String?   @map("campaign_name") @db.VarChar(512)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, campaignId])
  @@index([workspaceId])
  @@map("workspace_ad_campaign_classifications")
}

model WorkspaceAiInsightsCache {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  periodDays  Int       @map("period_days")
  insights    Json
  modelUsed   String    @map("model_used") @db.VarChar(120)
  generatedAt DateTime  @default(now()) @map("generated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodDays])
  @@index([workspaceId])
  @@map("workspace_ai_insights_cache")
}

model WorkspaceCogsSettings {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String    @unique @map("workspace_id") @db.Uuid
  overrideAllCogsPercent Decimal   @default(0) @map("override_all_cogs_percent") @db.Decimal(5, 2)
  fallbackCogsPercent    Decimal   @default(0) @map("fallback_cogs_percent") @db.Decimal(5, 2)
  cogsMarkupPercent      Decimal   @default(0) @map("cogs_markup_percent") @db.Decimal(5, 2)
  updatedAt              DateTime  @updatedAt @map("updated_at")
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_cogs_settings")
}

model WorkspaceMember {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  role        WorkspaceRole @default(VIEWER)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Invitation {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String
  workspaceId String           @map("workspace_id") @db.Uuid
  role        WorkspaceRole    @default(VIEWER)
  status      InvitationStatus @default(PENDING)
  token       String           @unique @default(dbgenerated("gen_random_uuid()"))
  invitedById String           @map("invited_by_id") @db.Uuid
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email, workspaceId])
  @@index([token])
  @@map("invitations")
}

model WorkspaceCost {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String                   @map("workspace_id") @db.Uuid
  costType      WorkspaceCostType        @map("cost_type")
  name          String?                  @db.VarChar(120)
  amount        Decimal                  @db.Decimal(12, 2)
  effectiveFrom DateTime                 @map("effective_from") @db.Date
  effectiveTo   DateTime?                @map("effective_to") @db.Date
  currency      String?                  @default("USD") @db.VarChar(3)
  createdAt     DateTime                 @default(now()) @map("created_at")
  isPercent     Boolean                  @default(false) @map("is_percent")
  billingMode   WorkspaceCostBillingMode @default(monthly) @map("billing_mode")
  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, costType, effectiveFrom, effectiveTo])
  @@map("workspace_costs")
}

model WorkspaceMiscExpense {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String    @map("workspace_id") @db.Uuid
  name               String    @db.VarChar(200)
  amount             Decimal   @db.Decimal(12, 2)
  currency           String    @default("INR") @db.VarChar(3)
  effectiveStartDate DateTime  @map("effective_start_date") @db.Date
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, effectiveStartDate])
  @@map("workspace_misc_expenses")
}

model ShopifyConnection {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId               String                      @map("workspace_id") @db.Uuid
  shopDomain                String                      @map("shop_domain")
  shopifyStoreId            String?                     @map("shopify_store_id")
  accessToken               String?                     @map("access_token")
  scopes                    String[]
  status                    ConnectionStatus            @default(CONNECTED)
  installedAt               DateTime                    @default(now()) @map("installed_at")
  lastSyncAt                DateTime?                   @map("last_sync_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  clientId                  String                      @map("client_id")
  clientSecret              String                      @map("client_secret")
  tokenExpiresAt            DateTime?                   @map("token_expires_at")
  analyticsDaily            ShopifyAnalyticsDaily[]
  workspace                 Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customers                 ShopifyCustomer[]
  lineItems                 ShopifyLineItem[]
  orders                    ShopifyOrder[]
  products                  ShopifyProduct[]
  shopify_refund_line_items shopify_refund_line_items[]
  variants                  ShopifyVariant[]

  @@unique([workspaceId, shopDomain])
  @@map("shopify_connections")
}

model ShopifyAnalyticsDaily {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId   String            @map("connection_id") @db.Uuid
  date           DateTime          @db.Date
  netSales       Decimal           @map("net_sales") @db.Decimal(12, 2)
  grossSales     Decimal           @map("gross_sales") @db.Decimal(12, 2)
  ordersCount    Int               @map("orders_count")
  aov            Decimal           @db.Decimal(12, 2)
  totalTax       Decimal           @map("total_tax") @db.Decimal(12, 2)
  totalDiscount  Decimal           @map("total_discount") @db.Decimal(12, 2)
  currency       String
  updatedAt      DateTime          @updatedAt @map("updated_at")
  conversionRate Decimal?          @map("conversion_rate") @db.Decimal(8, 4)
  sessions       Int?
  returns        Decimal?          @map("returns") @db.Decimal(12, 2)
  total_returns  Decimal?          @db.Decimal(12, 2)
  connection     ShopifyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, date])
  @@index([connectionId, date])
  @@map("shopify_analytics_daily")
}

model ShopifyOrder {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId      String            @map("connection_id") @db.Uuid
  shopifyId         String            @map("shopify_id")
  orderNumber       String            @map("order_number")
  name              String
  email             String?
  totalPrice        Decimal           @map("total_price") @db.Decimal(12, 2)
  subtotalPrice     Decimal           @map("subtotal_price") @db.Decimal(12, 2)
  totalTax          Decimal           @map("total_tax") @db.Decimal(12, 2)
  totalDiscount     Decimal           @map("total_discount") @db.Decimal(12, 2)
  currency          String
  financialStatus   String            @map("financial_status")
  fulfillmentStatus String?           @map("fulfillment_status")
  customerShopifyId String?           @map("customer_shopify_id")
  processedAt       DateTime          @map("processed_at")
  cancelledAt       DateTime?         @map("cancelled_at")
  tags              String[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  lineItems         ShopifyLineItem[]
  connection        ShopifyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, shopifyId])
  @@index([connectionId, processedAt])
  // Faster filtering for the Orders table (we filter by exact status values).
  @@index([connectionId, financialStatus])
  @@index([connectionId, fulfillmentStatus])
  @@map("shopify_orders")
}

model ShopifyLineItem {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String            @map("order_id") @db.Uuid
  connectionId     String            @map("connection_id") @db.Uuid
  shopifyId        String            @map("shopify_id")
  title            String
  quantity         Int
  price            Decimal           @db.Decimal(12, 2)
  sku              String?
  variantTitle     String?           @map("variant_title")
  productShopifyId String?           @map("product_shopify_id")
  connection       ShopifyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  order            ShopifyOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([connectionId, shopifyId])
  @@index([orderId])
  @@map("shopify_line_items")
}

model ShopifyProduct {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId   String            @map("connection_id") @db.Uuid
  shopifyId      String            @map("shopify_id")
  title          String
  handle         String
  vendor         String?
  productType    String?           @map("product_type")
  status         String
  tags           String[]
  imageUrl       String?           @map("image_url")
  totalInventory Int?              @map("total_inventory")
  publishedAt    DateTime?         @map("published_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  coq            Decimal?          @map("coq") @db.Decimal(12, 4)
  connection     ShopifyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  variants       ShopifyVariant[]

  @@unique([connectionId, shopifyId])
  @@index([connectionId])
  @@map("shopify_products")
}

model ShopifyVariant {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId      String            @map("connection_id") @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  shopifyId         String            @map("shopify_id")
  title             String?
  sku               String?
  price             Decimal?          @db.Decimal(12, 2)
  compareAtPrice    Decimal?          @map("compare_at_price") @db.Decimal(12, 2)
  inventoryQuantity Int?              @map("inventory_quantity")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  connection        ShopifyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  product           ShopifyProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([connectionId, shopifyId])
  @@index([productId])
  @@map("shopify_variants")
}

model ProductLeadTime {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  productShopifyId String   @map("product_shopify_id")
  leadTimeDays     Int      @default(0) @map("lead_time_days")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, productShopifyId])
  @@map("product_lead_times")
}

model ShopifyCustomer {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId     String            @map("connection_id") @db.Uuid
  shopifyId        String            @map("shopify_id")
  email            String?
  firstName        String?           @map("first_name")
  lastName         String?           @map("last_name")
  ordersCount      Int               @default(0) @map("orders_count")
  totalSpent       Decimal           @default(0) @map("total_spent") @db.Decimal(12, 2)
  currency         String?
  tags             String[]
  state            String?
  shopifyCreatedAt DateTime?         @map("shopify_created_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  connection       ShopifyConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, shopifyId])
  @@index([connectionId])
  @@map("shopify_customers")
}

model ShiprocketConnection {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String               @unique @map("workspace_id") @db.Uuid
  email              String
  password           String
  shiprocketApiEmail String?              @map("shiprocket_api_email")
  shiprocketApiPassword String?           @map("shiprocket_api_password")
  accessToken        String?              @map("access_token")
  tokenObtainedAt    DateTime?            @map("token_obtained_at")
  status             ConnectionStatus     @default(CONNECTED)
  lastSyncAt         DateTime?            @map("last_sync_at")
  lastSyncError      String?              @map("last_sync_error")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  channels           Json?
  selectedChannelIds String[]             @map("selected_channel_ids")
  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders             ShiprocketOrder[]
  shipments          ShiprocketShipment[]

  @@map("shiprocket_connections")
}

model KlaviyoConnection {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String             @unique @map("workspace_id") @db.Uuid
  apiKey               String             @map("api_key")
  conversionMetricId   String?            @map("conversion_metric_id")
  status               ConnectionStatus   @default(CONNECTED)
  lastSyncAt           DateTime?          @map("last_sync_at")
  lastSyncError        String?            @map("last_sync_error")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailPerformance     EmailPerformance[]

  @@map("klaviyo_connections")
}

/// Klaviyo campaign / flow send performance (one row per send date for flows).
model EmailPerformance {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String            @map("workspace_id") @db.Uuid
  klaviyoConnectionId String            @map("klaviyo_connection_id") @db.Uuid
  channel             String            @db.VarChar(16)
  sourceType          String            @map("source_type") @db.VarChar(24)
  klaviyoResourceId   String            @map("klaviyo_resource_id") @db.VarChar(64)
  name                String            @db.VarChar(512)
  sendDate            DateTime          @map("send_date") @db.Date
  delivered           Int               @default(0)
  uniqueOpens         Int               @default(0) @map("unique_opens")
  uniqueClicks        Int               @default(0) @map("unique_clicks")
  orders              Int               @default(0)
  revenue             Decimal           @default(0) @map("revenue") @db.Decimal(18, 4)
  unsubscribes        Int               @default(0)
  spamComplaints      Int               @default(0) @map("spam_complaints")
  syncedAt            DateTime          @default(now()) @map("synced_at")
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  klaviyoConnection   KlaviyoConnection @relation(fields: [klaviyoConnectionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sourceType, klaviyoResourceId, sendDate])
  @@index([workspaceId, sendDate])
  @@index([klaviyoConnectionId])
  @@map("email_performance")
}

model ShiprocketOrder {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId   String               @map("connection_id") @db.Uuid
  shiprocketId   String               @map("shiprocket_id")
  channelOrderId String?              @map("channel_order_id")
  status         String?
  statusCode     Int?                 @map("status_code")
  paymentMethod  String?              @map("payment_method")
  total          Decimal?             @db.Decimal(12, 2)
  orderDate      DateTime?            @map("order_date")
  channelName    String?              @map("channel_name")
  rawJson        Json?                @map("raw_json")
  syncedAt       DateTime             @default(now()) @map("synced_at")
  channelId      String?              @map("channel_id")
  connection     ShiprocketConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, shiprocketId])
  @@index([connectionId, orderDate])
  @@map("shiprocket_orders")
}

model ShiprocketShipment {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connectionId        String               @map("connection_id") @db.Uuid
  shipmentId          String               @map("shipment_id")
  orderId             String?              @map("order_id")
  status              String?
  statusCode          Int?                 @map("status_code")
  courierName         String?              @map("courier_name")
  awbCode             String?              @map("awb_code")
  isCod               Boolean              @default(false) @map("is_cod")
  codAmount           Decimal?             @map("cod_amount") @db.Decimal(12, 2)
  shippedAt           DateTime?            @map("shipped_at")
  deliveredAt         DateTime?            @map("delivered_at")
  rtoInitiatedAt      DateTime?            @map("rto_initiated_at")
  charges             Decimal?             @db.Decimal(12, 2)
  rawJson             Json?                @map("raw_json")
  syncedAt            DateTime             @default(now()) @map("synced_at")
  channelOrderId      String?              @map("channel_order_id")
  trackingStatus      String?              @map("tracking_status")
  trackingStatusCode  Int?                 @map("tracking_status_code")
  trackingUpdatedAt   DateTime?            @map("tracking_updated_at")
  paymentMethod       String?              @map("payment_method")
  shiprocketCreatedAt DateTime?            @map("shiprocket_created_at")
  shopifyOrderName    String?              @map("shopify_order_name")
  deliveryPincode     String?              @map("delivery_pincode")
  deliveryCity        String?              @map("delivery_city")
  deliveryState       String?              @map("delivery_state")
  connection          ShiprocketConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, shipmentId])
  @@index([connectionId, trackingStatusCode])
  @@index([connectionId, shiprocketCreatedAt])
  @@index([connectionId, deliveryPincode])
  @@map("shiprocket_shipments")
}

model AuditLog {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?    @map("workspace_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  action      String
  entityType  String     @map("entity_type")
  entityId    String?    @map("entity_id")
  metadata    Json?
  ipAddress   String?    @map("ip_address")
  userAgent   String?    @map("user_agent")
  createdAt   DateTime   @default(now()) @map("created_at")
  user        User       @relation(fields: [userId], references: [id])
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  workspaceId String?          @map("workspace_id") @db.Uuid
  type        NotificationType
  title       String
  body        String?
  actionUrl   String?          @map("action_url")
  read        Boolean          @default(false)
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  readAt      DateTime?        @map("read_at")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?       @relation(fields: [workspaceId], references: [id])

  @@index([userId, read, createdAt])
  @@index([workspaceId, createdAt])
  @@map("notifications")
}

